# Email service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Contact email
CONTACT_EMAIL=sales@jaak.ai

# CRM Integration (optional)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Google Tag Manager (for analytics, conversion tracking, etc.)
# Get your GTM ID from: https://tagmanager.google.com/
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Cloudflare Turnstile (for form protection)
# Get your Site Key from: https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE=0x4AAAA...
# Server-side secret for siteverify (keep private, never expose to client)
TURNSTILE_SECRET_KEY=

# Kairos Sales Chat Widget (for lead capture)
# Widget URL (defaults to https://chat.kairos.jaak.ai/widget.js)
NEXT_PUBLIC_KAIROS_WIDGET_URL=https://chat.kairos.jaak.ai/widget.js
# Tenant ID for multi-tenant support (defaults to "jaak")
NEXT_PUBLIC_KAIROS_TENANT_ID=jaak

# API pública de JAAK para hidratar IDs de pricing del autoservicio (default: prod)
JAAK_API_BASE_URL=https://services.api.jaak.ai

# Kairos public lead intake (atribución UTM de campañas).
# Si KAIROS_API_URL está vacío, el forward a Kairos se desactiva (no-op).
KAIROS_API_URL=https://kairos.api.jaak.ai
# Solo si Kairos tiene LEAD_API_KEY configurado (header X-LEAD-API-KEY)
KAIROS_LEAD_API_KEY=
# Origin enviado a Kairos (debe estar en PUBLIC_LEAD_ORIGINS de Kairos)
NEXT_PUBLIC_SITE_ORIGIN=https://www.jaak.ai

# Experimento B — Firma Simple Cobre express checkout (Stripe Payment Link LIVE)
# Crear con: python3 scripts/create_firma_simple_cobre_payment_link.py --live
# o Dashboard Stripe → Payment links. Nunca dejes un link /test_ en producción.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_FIRMA_SIMPLE_COBRE=
# Opcional: override del link test (dev only)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_FIRMA_SIMPLE_COBRE_TEST=

# Microsoft Clarity (heatmaps + session replay). Project ID from clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# Optional: GA4 Measurement Protocol for server-side LP events
# GA4_MEASUREMENT_ID=G-XXXXXXXX
# GA4_API_SECRET=
